{
  "name": "dsh-accessmux-connect",
  "displayName": "DSH AccessMux Connect",
  "description": "把 AccessMux 本地桥接守护的模型（workbuddy:* / trae-cn:* / trae-global:*）接入 DeepSeek Harness，零凭据配置 — bring AccessMux bridged models into DeepSeek Harness with zero credentials.",
  "version": "0.1.0",
  "author": "AccessMux",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "accessmux",
    "model-provider"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.5-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.5-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.2 <4.0.0",
    "@earendil-works/pi-ai": ">=0.85.1 <0.88.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@earendil-works/pi-ai": "0.87.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "private": true
}
